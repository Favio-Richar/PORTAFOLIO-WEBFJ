# ============================
# DATABASE
# ============================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portafolio-web
SQL_ECHO=false

# ============================
# SECURITY / PRODUCTION
# ============================
# Enable strict startup checks in production.
SECURITY_STRICT_MODE=false
# Must stay true in production.
ADMIN_REQUIRE_AUTH=true
# Must stay false in production.
CORS_ALLOW_ALL=false
# Public URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
API_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Replace with a long random secret in production.
SECRET_KEY=change-this-super-secret-key

# ============================
# CLOUDINARY
# ============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================
# GOOGLE OAUTH
# ============================
GOOGLE_CLIENT_ID=
# Optional multiple ids separated by comma:
# GOOGLE_CLIENT_IDS=id1,id2

# ============================
# EMAIL (RESEND)
# ============================
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Optional webhook secret for /api/subscribers/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Send retry policy
EMAIL_SEND_MAX_ATTEMPTS=2
EMAIL_SEND_RETRY_BACKOFF_MS=700

# ============================
# NEWSLETTER / SUBSCRIPTIONS
# ============================
# Public form anti-abuse
NEWSLETTER_SUBSCRIBE_RATE_LIMIT_ENABLED=true
NEWSLETTER_SUBSCRIBE_RATE_WINDOW_SECONDS=60
NEWSLETTER_SUBSCRIBE_RATE_MAX_REQUESTS=10
NEWSLETTER_MIN_SUBMIT_SECONDS=2
# Double opt-in
NEWSLETTER_DOUBLE_OPT_IN=false
NEWSLETTER_CONFIRM_TOKEN_HOURS=48

# ============================
# WHATSAPP CLOUD API
# ============================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=56912345678

# ============================
# BOOKINGS / ADVISORIES
# ============================
BOOKING_TIMEZONE=America/Santiago
BOOKING_MEETING_FALLBACK_PROVIDER=none
REMINDERS_AUTOMATIC_ENABLED=true
REMINDERS_POLL_SECONDS=300
REMINDER_WINDOW_MINUTES=30

# Google Meet via Google Calendar API
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=

# Microsoft Teams (Graph API)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER_USER_ID=

# Whereby optional
WHEREBY_ROOM_PREFIX=asesoria
