# Configuración de Base de Datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portafolio-web

# Configuración de Cloudinary (Obtenidos de cloudinary.com)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Google OAuth (opcionalmente varios client IDs separados por coma)
GOOGLE_CLIENT_ID=686141217518-3ogat5mr2gassq258va2g50o65r26638.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=client_id_anterior,client_id_nuevo

# Resend (correo automatico de confirmacion de reservas)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# WhatsApp Cloud API (Meta) para recibir mensajes del chat web
WHATSAPP_ACCESS_TOKEN=tu_token_de_meta
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
# Numero destino (si no se define, se usa /api/contact -> whatsapp)
WHATSAPP_TO_NUMBER=56912345678

# ----------------------------
# RESERVAS / ASESORIAS (REAL)
# ----------------------------
# Zona horaria usada para agendas
BOOKING_TIMEZONE=America/Santiago

# Fallback cuando falla proveedor principal: jitsi | whereby | google_meet | teams | none
# Recomendado para flujo profesional: none
BOOKING_MEETING_FALLBACK_PROVIDER=none

# Recordatorios automaticos por correo (24h y 1h antes)
REMINDERS_AUTOMATIC_ENABLED=true
# Cada cuantos segundos se revisan recordatorios pendientes
REMINDERS_POLL_SECONDS=300
# Ventana de envio alrededor de la marca objetivo (en minutos)
REMINDER_WINDOW_MINUTES=30

# Google Meet via Google Calendar API (Service Account)
# Puedes usar archivo o JSON inline (usa uno de los dos)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary
# Si usas dominio Google Workspace y delegacion:
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=

# Microsoft Teams (Graph API)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# Email o id del usuario organizador
TEAMS_ORGANIZER_USER_ID=

# Whereby opcional
WHEREBY_ROOM_PREFIX=asesoria
